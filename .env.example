# ---------------------------------------------------------------------------
# Eventora – copy this file to ".env" and edit the values.
#   Copy-Item .env.example .env      (Windows PowerShell)
#   cp .env.example .env             (macOS / Linux)
# ".env" is never served by the website and must not be committed.
# ---------------------------------------------------------------------------

# Flask session signing key – REQUIRED in production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string
SESSION_HOURS=8
SESSION_COOKIE_SECURE=0
FLASK_DEBUG=0

# MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123
MYSQL_DATABASE=eventora_db
# Start MySQL automatically when nothing is listening on MYSQL_HOST:MYSQL_PORT.
# A machine without a MySQL Windows service (see start.ps1) otherwise shows
# "The database is not reachable" on the admin panel whenever MySQL was not
# started by hand. 1 = the app starts it, 0 = off. Only a closed port ever
# starts a server - a wrong password or a missing database never does.
MYSQL_AUTOSTART=1
MYSQL_START_TIMEOUT=60
# Optional - only needed when mysqld lives somewhere unusual:
# MYSQLD_PATH=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysqld.exe
# MYSQL_DEFAULTS_FILE=C:\ProgramData\MySQL\MySQL Server 8.4\my.ini
# If MYSQL_DEFAULTS_FILE above doesn't exist, auto-start now uses a fixed
# local data folder (./.mysql-data) instead of mysqld's undefined default,
# so admin logins/uploads persist across restarts. Override if you want it
# elsewhere:
# MYSQL_MANAGED_DATA_DIR=C:\eventora-mysql-data

# Upload limits (megabytes)
MAX_UPLOAD_MB=128
MAX_IMAGE_MB=12
MAX_VIDEO_MB=128

# Optional: used by "python app.py init-db" / "create-admin" to create the
# first administrator without any typing. Leave ADMIN_PASSWORD empty to be
# asked for it (recommended – the password never touches a file).
ADMIN_USERNAME=raj
ADMIN_PASSWORD=kumar123
# Shortest password create-admin accepts. Keep it at 8 (or more) in production;
# lower it only on a private demo machine. This must be <= the length of
# ADMIN_PASSWORD above, otherwise "init-db" silently creates no account and the
# admin login can never succeed.
MIN_PASSWORD_LENGTH=3
