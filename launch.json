    {
      "name": "Python: Flask (workspace root launcher)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\app.py",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
